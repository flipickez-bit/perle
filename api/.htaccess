# ── API Perle ────────────────────────────────────────────────────────────

# Tout passe par index.php, qui decide seul de ce qui existe.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /api/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ index.php [QSA,L]
</IfModule>

# La configuration contient le mot de passe de la base et la cle Stripe :
# elle ne doit jamais etre servie, meme si le PHP venait a ne plus s'executer.
<FilesMatch "^config.*\.php$">
  Require all denied
</FilesMatch>

# Les fichiers internes ne sont pas des points d'entree.
RedirectMatch 404 ^/api/(lib|routes)/
