# ── Perle — configuration serveur ────────────────────────────────

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Domaine canonique : www.perleexperience.com -> perleexperience.com
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # Pages supprimees lors du repositionnement sur les stages
  RewriteRule ^formules\.html$   /stages.html       [R=301,L]
  RewriteRule ^galerie\.html$    /historique.html   [R=301,L]
  RewriteRule ^lieux\.html$      /stages.html       [R=301,L]
  RewriteRule ^histoire\.html$   /historique.html   [R=301,L]
</IfModule>

# ── Compression ──────────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ── Cache navigateur ─────────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css                "access plus 1 year"
  ExpiresByType application/javascript  "access plus 1 year"
  ExpiresByType image/jpeg              "access plus 6 months"
  ExpiresByType image/png               "access plus 6 months"
  ExpiresByType video/mp4               "access plus 6 months"
  ExpiresByType text/html               "access plus 0 seconds"
</IfModule>
