# ── Perle — configuration serveur ────────────────────────────────

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Domaine canonique : www.perleexperience.com -> perleexperience.com
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # Pages supprimees lors du repositionnement sur les stages
  RewriteRule ^formules\.html$   /stages.html       [R=301,L]
  RewriteRule ^galerie\.html$    /historique.html   [R=301,L]
  RewriteRule ^lieux\.html$      /stages.html       [R=301,L]
  RewriteRule ^histoire\.html$   /historique.html   [R=301,L]
</IfModule>

# ── Page d'erreur personnalisee ──────────────────────────────
ErrorDocument 404 /404.html

# ── Compression ──────────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ── Cache navigateur ─────────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  # Feuille de style et scripts : duree courte. Le site evolue souvent et
  # une visiteuse ne doit jamais rester bloquee sur une ancienne version.
  # Les liens portent en plus un numero de version (?v=) qui force le
  # rechargement immediat a chaque mise a jour.
  ExpiresByType text/css                "access plus 1 hour"
  # Le JavaScript est annonce sous trois noms selon les serveurs. Hostinger
  # emploie application/x-javascript : ne viser que application/javascript
  # laissait la regle sans effet, et le navigateur gardait l'ancien fichier
  # sept jours durant.
  ExpiresByType application/javascript   "access plus 1 hour"
  ExpiresByType text/javascript          "access plus 1 hour"
  ExpiresByType application/x-javascript "access plus 1 hour"
  ExpiresByType image/jpeg              "access plus 6 months"
  ExpiresByType image/png               "access plus 6 months"
  ExpiresByType video/mp4               "access plus 6 months"
  ExpiresByType text/html               "access plus 0 seconds"
</IfModule>
